#Growing VG and LV using New Disk

fdisk /dev/sde < text
pvcreate /dev/sde1
vgextend ssd /dev/sde1
lvextend -l +100%FREE /dev/ssd/anisa
resize2fs /dev/ssd/anisa 

df -khl
vgs
pvs
lvs
------------------------------
#Growing LV using other LV (from backup to anisa)

lvcreate -L 5g ssd -n Backup
mkdir /Backup
mkfs -t ext4 /dev/ssd/Backup

vim /etc/fstab

#end of fstap
/dev/ssd/Backup  /Backup  ext4   defaults   0    0
Or
UUID="d2229746-d284-4925-853d-404fb946e233 /Backup  ext4   defaults   0    0

