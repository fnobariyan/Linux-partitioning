#Setup First LVM
#1-Ceart a script for partitioning 

vi txt

g #Created a new GPT disklabel
n #New
t #Selected partition 1 Partition type #30 Linux LVM
p #Print
w #Write

fdisk /dev/sdb < txt > /dev/null
fdisk /dev/sdc < txt > /dev/null
fdisk /dev/sdd < txt > /dev/null
fdisk /dev/sde < txt > /dev/null
-----------------------------
#2-Creat physical valume

pvcreate /dev/sd[b-e]1

#pvremove /dev/sde1 
  Labels on physical volume "/dev/sde1" successfully wiped.
-----------------------------
#4-Create volume Group

vgcreate ssd /dev/sd[b-d]1
-----------------------------
#5-format
mkfs -t ext4 /dev/ssd/anisa
-----------------------------
#6-mounting

mkdir /anisa

vim /etc/fstab

#end of fstap
/dev/ssd/anisa  /anisa  ext4   defaults   0    0

systemctl daemon-reload
mount -a
